<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="RemoteButton" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/bg_button_pill</item>
        <item name="android:textColor">@color/on_background</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
    </style>

    <style name="RemoteButton.Pill">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
    </style>

    <style name="RemoteButton.PillWeighted">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_weight">1</item>
    </style>

    <style name="RemoteButton.Round">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/bg_button_round</item>
        <item name="android:padding">0dp</item>
    </style>

</resources>
