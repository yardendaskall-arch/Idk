<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- ═══════════════════════  CAMERA SCREEN  ═══════════════════════ -->
    <FrameLayout
        android:id="@+id/cameraContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.camera.view.PreviewView
            android:id="@+id/viewFinder"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- App title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="52dp"
            android:text="@string/app_name"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:shadowColor="#AA000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="4" />

        <!-- Bottom capture bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bottom_gradient"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingBottom="28dp">

            <TextView
                android:id="@+id/captureHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:text="Point camera at your face"
                android:textColor="#CCFFFFFF"
                android:textSize="14sp" />

            <!-- Shutter button: white ring + purple inner disc -->
            <FrameLayout
                android:id="@+id/captureButton"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/capture_button_bg"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <View
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:background="@drawable/capture_button_inner" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- ═══════════════════════  RESULT SCREEN  ═══════════════════════ -->
    <ScrollView
        android:id="@+id/resultContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="@color/bg_dark">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp"
            android:paddingTop="52dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your Face Emoji"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"
                android:layout_marginBottom="28dp" />

            <!-- Generated emoji (main result) -->
            <ImageView
                android:id="@+id/generatedEmojiView"
                android:layout_width="280dp"
                android:layout_height="280dp"
                android:scaleType="centerInside"
                android:background="@drawable/image_bg"
                android:padding="8dp" />

            <!-- Expression label -->
            <TextView
                android:id="@+id/tvLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Generating…"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="20dp" />

            <!-- Small reference photo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reference photo"
                android:textColor="#66FFFFFF"
                android:textSize="11sp"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="8dp" />

            <ImageView
                android:id="@+id/capturedImageView"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:scaleType="centerCrop"
                android:background="@drawable/image_bg"
                android:padding="2dp" />

            <!-- Retake -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/retakeButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="36dp"
                android:text="Try Another Face"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                app:backgroundTint="@color/purple_500"
                app:cornerRadius="28dp" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>
